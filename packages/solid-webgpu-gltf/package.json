{
  "name": "solid-webgpu-gltf",
  "license": "MIT",
  "version": "0.1.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && rollup -c ./rollup.config.js && tsc",
    "watch": "concurrently \"rollup -w -c ./rollup.config.js\" \"tsc -w\""
  },
  "dependencies": {
    "solid-webgpu": "workspace:*"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-beta.17",
    "solid-js": "^2.0.0-beta.17"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-beta.17",
    "@types/node": "^22.10.2",
    "babel-preset-solid": "2.0.0-beta.17",
    "json-schema-to-typescript": "^15.0.3",
    "solid-js": "2.0.0-beta.17",
    "solid-webgpu": "workspace:*"
  }
}
